VITE_ADSENSE_SLOT_CONTENT=
VITE_ADSENSE_SLOT_CALCULATOR=
VITE_ADSENSE_SLOT_FOOTER=

# Optional Contact Form
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
